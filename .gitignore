outputs/regional-candidate-pool/**/taxonomy_name_resolution.csv
data/final/*.csv.gz
data/final/*.partial
data/final/**/*.csv.gz
data/final/**/*.partial

# Large habitat record audits and caches; summaries and provenance remain versioned.
