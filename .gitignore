*DwC-A*

# Local/generated logs
*.log

# Large reference and logistics PDFs kept locally
docs/field-logistics/*.pdf
references/papers/*.pdf

# analysis/scripts pipeline: large generated intermediate/output files
# (multi-hundred-MB to multi-GB) are excluded; small per-run metadata
# and the small final summary outputs are kept so a real verified run
# is visible in the repo (see each step's README "Verified against the
# real download" sections).
analysis/scripts/01-download-gbif-arthropoda-ca/output/dwca/
analysis/scripts/02-trim-gbif-columns/output/occurrence_trimmed.txt
analysis/scripts/03-merge-deduplicate/output/dwc_merged_deduplicated.csv
analysis/scripts/04-resolve-cibi-bold-ids/output/dwc_merged_cibi_resolved.csv
analysis/scripts/05-filter-latrange-overlap/output/dwc_coords_complete.csv
analysis/scripts/05-filter-latrange-overlap/output/dwc_latrange_overlap.csv
analysis/scripts/06-boundary-distance/output/dwc_distance_to_boundary.csv
analysis/scripts/08-species-mcp-overlap/output/_checkpoint_after_loop.rds
analysis/scripts/08-species-mcp-overlap/output/_checkpoint_in_progress.rds

# Large generated results remain available locally; regenerate from source data.
analysis/scripts/08-species-mcp-overlap/output/species_mcp_polygons.geojson
analysis/scripts/06-boundary-distance/output/nearest_record_per_species_including_outside_extent.csv
outputs/regional-candidate-pool/**/*.csv.gz
outputs/regional-candidate-pool/**/*.partial
outputs/regional-candidate-pool/**/taxonomy_api_cache.jsonl
outputs/regional-candidate-pool/**/taxonomy_name_resolution.csv
data/final/*.csv.gz
data/final/*.partial

# Record-level habitat evidence; summarized annotations remain versioned.
outputs/habitat-notes/**/*.csv.gz

